{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "bluetooth",
        "pulseaudio",
        "niri/language"
    ],

    "niri/workspaces": {
        "format": " {index} "
    },

    "niri/window": {
        "format": "{title}",
        "max-length": 50,
        "separate-outputs": true,
        "tooltip": false
    },

    "clock": {
        "locale": "en_GB.UTF-8",
        "interval": 60,
        "format": "[ <span color='#57606a'>{0:%a %d.%m}</span> <span color='#000000'><b>{0:%H:%M}</b></span> ]",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#000000'><b>{}</b></span>",
                "days": "<span color='#212529'>{}</span>",
                "weeks": "<span color='#57606a'><b>W{}</b></span>",
                "weekdays": "<span color='#0969da'><b>{}</b></span>",
                "today": "<span color='#ffffff' background='#cf222e'><b> {} </b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "cpu": {
        "interval": 5,
        "format": "CPU: {usage}%",
        "on-click": "foot -e btop",
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "RAM: {percentage}%",
        "on-click": "foot -e btop",
        "tooltip": false
    },

    "bluetooth": {
        "format": "BT: ON",
        "format-disabled": "BT: OFF",
        "format-off": "BT: OFF",
        "format-connected": "BT: {device_alias}",
        "format-connected-battery": "BT: {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "foot -e bluetui"
    },

    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "VOL: MUTE",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 1,
        "tooltip": false
    },

    "niri/language": {
        "format": "[ {} ]",
        "format-en-colemak_dh": "DH",
        "format-us-colemak_dh": "DH",
        "format-en": "QW",
        "format-us": "QW",
        "format-ru": "RU",
        "on-click": "niri msg action switch-layout next",
        "tooltip": false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8,
        "show-passive-items": true
    }
}
