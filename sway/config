include /etc/sway/config.d/*

set $mod Mod4

set $left  m
set $down  n
set $up    e
set $right i

set $l_up    w
set $l_left  a
set $l_down  r
set $l_right s

set $term foot
set $menu fuzzel

set $wallpaper $HOME/Pictures/Wallpapers/space.png

set $lock_cmd      swaylock -f -c 000000
set $shot_cmd      sh -c "grim -g '$(slurp)' - | wl-copy -t image/png"
set $gamma_toggle  sh -c "pkill -x gammastep 2>/dev/null || exec gammastep -O 2000"
set $exit_prompt   swaynag -t warning -m 'SYSTEM HALT?' -B 'CONFIRM' 'swaymsg exit' \
                   --background 000000 --text ffffff --button-background ff0055 \
                   --button-text ffffff --border ff0055

set $bg_void    #000000
set $bg_panel   #101012
set $bg_urgent  #ff0055

set $br_focused #7c4dff
set $br_normal  #222222
set $br_urgent  #ff0055

set $tx_fg      #c0c0d0
set $tx_focus   #ffffff
set $tx_dim     #444455

font pango:Iosevka Term 10

default_border pixel 3
default_floating_border pixel 3
gaps inner 0
gaps outer 0

# Class                 Border       Background  Text       Indicator    ChildBorder
client.focused          $br_focused  $bg_void    $tx_focus  $br_focused  $br_focused
client.focused_inactive $br_normal   $bg_void    $tx_fg     $br_normal   $br_normal
client.unfocused        $br_normal   $bg_void    $tx_dim    $br_normal   $br_normal
client.urgent           $br_urgent   $bg_urgent  $tx_focus  $br_urgent   $br_urgent
client.placeholder      $br_normal   $bg_void    $tx_dim    $br_normal   $br_normal
client.background       $bg_void

input "type:keyboard" {
    xkb_layout  "us,ru"
    xkb_variant "colemak_dh,"
    xkb_options "grp:alt_shift_toggle,caps:escape"

    repeat_delay 200
    repeat_rate  60
}

input "type:touchpad" {
    dwt enabled
    tap enabled
    middle_emulation enabled
}

seat seat0 xcursor_theme phinger-cursors-dark 24

output * bg $wallpaper fill

exec_always {
    systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
    dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway
}

exec_always sh -c 'systemctl --user start --no-block pipewire.service wireplumber.service pipewire-pulse.service 2>/dev/null || true'

exec_always sh -c 'pkill -x swayidle 2>/dev/null || true
  exec swayidle -w \
    timeout 300 "'"$lock_cmd"'" \
    timeout 600 "swaymsg \"output * power off\"" resume "swaymsg \"output * power on\"" \
    before-sleep "'"$lock_cmd"'"'

for_window [app_id=".*"] inhibit_idle fullscreen
for_window [class=".*"]  inhibit_idle fullscreen


bindsym --to-code $mod+Return exec $term
bindsym --to-code $mod+q      kill
bindsym --to-code $mod+a      exec $menu

bindsym --to-code $mod+Shift+c reload
bindsym --to-code $mod+Shift+q exec $exit_prompt

bindsym --to-code $mod+Escape exec $lock_cmd
bindsym --to-code $mod+Shift+s exec $shot_cmd
bindsym --to-code $mod+g exec $gamma_toggle

bindsym --to-code $mod+$left  focus left
bindsym --to-code $mod+$down  focus down
bindsym --to-code $mod+$up    focus up
bindsym --to-code $mod+$right focus right

bindsym --to-code $mod+Shift+$left  move left
bindsym --to-code $mod+Shift+$down  move down
bindsym --to-code $mod+Shift+$up    move up
bindsym --to-code $mod+Shift+$right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym --to-code $mod+f        floating toggle
bindsym --to-code $mod+Shift+f  fullscreen

bindsym --to-code $mod+Tab        scratchpad show
bindsym --to-code $mod+Shift+Tab  move scratchpad

bindsym --to-code $mod+s layout stacking
bindsym --to-code $mod+w layout tabbed

bindsym --to-code $mod+b splith
bindsym --to-code $mod+v splitv
bindsym --to-code $mod+Shift+Space layout toggle split

bindsym --to-code $mod+p       focus parent
bindsym --to-code $mod+Shift+p focus child

bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-
bindsym --locked XF86AudioMute        exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec wpctl set-mute   @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86MonBrightnessUp   exec brightnessctl set 1%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 1%-

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPrev exec playerctl previous

bindsym --to-code $mod+r mode "resize"

mode "resize" {
    bindsym --to-code $l_left  resize shrink width  10px
    bindsym --to-code $l_down  resize grow   height 10px
    bindsym --to-code $l_up    resize shrink height 10px
    bindsym --to-code $l_right resize grow   width  10px

    bindsym --to-code $left  resize shrink width  10px
    bindsym --to-code $down  resize grow   height 10px
    bindsym --to-code $up    resize shrink height 10px
    bindsym --to-code $right resize grow   width  10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym --to-code $mod+r mode "default"
}

bar {
    swaybar_command waybar
}
